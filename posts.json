                "com_content": "<!-- 核心：网页唯一URL（必填） -->\r\n<meta property=\"og:url\" content=\"https:\/\/www.jiejoe.com\/\">\r\n<!-- 分享卡片标题（必填，建议控制在30字内） -->\r\n<meta property=\"og:title\" content=\"杰乔的个人网站 - 专注编程与生活分享\">\r\n<!-- 分享卡片描述（必填，建议80-120字） -->\r\n<meta property=\"og:description\" content=\"这里是杰乔的个人小站，分享编程技巧、职场经验和生活感悟，记录成长的每一步。\">\r\n<!-- 分享卡片主图（必填，替换成你的图片绝对URL） -->\r\n<meta property=\"og:image\" content=\"https:\/\/www.jiejoe.com\/images\/og-image.jpg\">\r\n<!-- 图片描述（可选，提升兼容性） -->\r\n<meta property=\"og:image:alt\" content=\"杰乔的个人网站封面图\">\r\n<!-- 图片尺寸（可选，帮助平台快速渲染） -->\r\n<meta property=\"og:image:width\" content=\"1200\">\r\n<meta property=\"og:image:height\" content=\"630\">\r\n<!-- 网页类型（必填，网站填website，文章填article） -->\r\n<meta property=\"og:type\" content=\"website\">\r\n<!-- 网站名称（可选） -->\r\n<meta property=\"og:site_name\" content=\"杰乔的个人网站\">\r\n\r\n<!-- 额外适配微信的配置（关键！微信优先读这个） -->\r\n<meta name=\"wechat:share:image\" content=\"https:\/\/www.jiejoe.com\/images\/og-image.jpg\">\r\n<meta name=\"description\" content=\"这里是杰乔的个人小站，分享编程技巧、职场经验和生活感悟，记录成长的每一步。\">",
