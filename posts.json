                "com_portrait": "portrait-img\/c27.jpg",
                "com_content": "<!-- 核心：网页唯一 URL -->\r\n<meta property=\"og:url\" content=\"https:\/\/www.jiejoe.com\/\">\r\n<!-- 分享卡片标题 -->\r\n<meta property=\"og:title\" content=\"杰乔的个人网站 - 专注技术与生活\">\r\n<!-- 分享卡片描述 -->\r\n<meta property=\"og:description\" content=\"分享编程技巧、生活感悟，记录成长点滴。\">\r\n<!-- 分享卡片图片（建议尺寸：1200x630，提升显示效果） -->\r\n<meta property=\"og:image\" content=\"https:\/\/www.jiejoe.com\/images\/og-image.jpg\">\r\n<!-- 网页类型（可选，如网站、文章、视频等） -->\r\n<meta property=\"og:type\" content=\"website\">\r\n<!-- 网站名称 -->\r\n<meta property=\"og:site_name\" content=\"杰乔的个人网站\">",
